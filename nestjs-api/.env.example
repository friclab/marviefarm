# MySQL — same credentials as the legacy app
DATABASE_URL="mysql://user:password@localhost:3306/marviefarm"

# JWT
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"

# Legacy CakePHP 1.3 Security.salt — needed only during password migration.
# Find it in www/marviefarm/app/config/core.php under Configure::write('Security.salt', ...)
# Once all users have logged in at least once (hash re-written to bcrypt) this can be removed.
CAKEPHP_SECURITY_SALT=""
